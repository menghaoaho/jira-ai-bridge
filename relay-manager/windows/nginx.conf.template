worker_processes 1;
pid "@DATA_ROOT@/nginx.pid";
error_log "@DATA_ROOT@/nginx-error.log" warn;
events { worker_connections 512; }
http {
    include "@NGINX_ROOT@/conf/mime.types";
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    map $http_upgrade $relay_connection { default upgrade; '' ''; }
    map $http_origin $relay_origin {
        default $http_origin;
        "@PUBLIC_ORIGIN@" "https://jira.example.internal";
    }
    map $http_referer $relay_referer {
        default $http_referer;
        "~^@ORIGIN_REGEX@(?<relay_path>/.*)$" "https://jira.example.internal$relay_path";
    }
    upstream jira_backend { server jira.example.internal:443; keepalive 16; }
    server {
        listen 127.0.0.1:@LOCAL_PORT@;
        server_name _;
        client_max_body_size 2g;
        proxy_ssl_server_name on;
        proxy_ssl_name jira.example.internal;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate "@DATA_ROOT@/windows-roots.pem";
        proxy_ssl_verify_depth 8;
        proxy_set_header Host jira.example.internal;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $relay_connection;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
        proxy_request_buffering off;
        location = /__jira_relay_health {
            proxy_set_header Host jira.example.internal;
            proxy_set_header Connection "";
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_hide_header X-Jira-Relay-Device;
            add_header X-Jira-Relay-Device "@DEVICE_ID@" always;
            proxy_pass https://jira_backend/login.jsp;
        }
        location / {
            proxy_set_header Host jira.example.internal;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $relay_connection;
            proxy_set_header Origin $relay_origin;
            proxy_set_header Referer $relay_referer;
            proxy_pass https://jira_backend;
        }
    }
}
